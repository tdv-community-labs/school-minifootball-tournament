rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Turnir statistikası və oyunları hər kəs oxuya bilər
    match /{document=**} {
      allow read: if true;
      // Yalnız sistem inzibatçıları və autentifikasiya olunmuş istifadəçilər məlumatları dəyişə/silə bilər
      allow write: if request.auth != null;
    }
  }
}
